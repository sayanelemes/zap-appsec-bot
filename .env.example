# =================================================================
# Токен бота, полученный у @BotFather (обязательно)
# =================================================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# =================================================================
# ID администраторов в Telegram (числа через запятую или JSON-список)
# Получить свой ID можно через бота @userinfobot
# =================================================================
ADMIN_IDS=123456789,987654321

# =================================================================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# =================================================================
LOG_LEVEL=INFO

# =================================================================
# Ограничение частоты запросов от одного пользователя (в секундах)
# =================================================================
THROTTLE_RATE=0.5

# =================================================================
# OWASP ZAP (локальный демон или Docker)
# В Docker Compose: http://zap:8080
# Локально: http://127.0.0.1:8090
# =================================================================
ZAP_URL=http://zap:8080
ZAP_API_KEY=your_zap_api_key_here

# =================================================================
# Google GenAI (Gemini API) для генерации AppSec-аудита и промптов
# Получить ключ: https://aistudio.google.com/app/apikey
# =================================================================
GEMINI_API_KEY=AIzaSy...ваш_ключ_gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
