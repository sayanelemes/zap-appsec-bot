# =================================================================
# Токен бота, полученный у @BotFather (обязательно)
# =================================================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# =================================================================
# Подключение к базе данных (SQLAlchemy Async URL)
# По умолчанию: SQLite для быстрого локального старта
# Для PostgreSQL: postgresql+asyncpg://bot_user:bot_password@localhost:5432/bot_db
# В Docker Compose: postgresql+asyncpg://bot_user:bot_password@postgres:5432/bot_db
# =================================================================
DB_URL=sqlite+aiosqlite:///bot.db

# =================================================================
# ID администраторов в Telegram (числа через запятую или JSON-список)
# Получить свой ID можно через бота @userinfobot
# =================================================================
ADMIN_IDS=123456789,987654321

# =================================================================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# =================================================================
LOG_LEVEL=INFO

# =================================================================
# Ограничение частоты запросов от одного пользователя (в секундах)
# =================================================================
THROTTLE_RATE=0.5

# =================================================================
# Опционально: Redis для FSM и кэша
# Если не указан, используется MemoryStorage
# REDIS_URL=redis://localhost:6379/0
# =================================================================
# REDIS_URL=

# =================================================================
# Google GenAI (Gemini API)
# Получить ключ: https://aistudio.google.com/app/apikey
# =================================================================
GEMINI_API_KEY=AIzaSy...ваш_ключ_gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
MAX_CONTEXT_HISTORY=10

